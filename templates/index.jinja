<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkautIS Contacts Converter</title>
    <style>
        body {
            margin: 0;
            background-color: #E6E4E0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        }

        .center {
            display: grid;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            text-align: center;
        }

        h1 {
            color: #1a5f2a;
            margin-bottom: 10px;
        }

        h3 {
            color: #666;
            font-weight: normal;
            margin-top: 5px;
        }

        .description {
            color: #555;
            margin: 20px 0;
            max-width: 500px;
        }

        form {
            margin: 20px 0;
        }

        input[type="file"] {
            margin-bottom: 15px;
        }

        button {
            background-color: #1a5f2a;
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: #2a7f3a;
        }

        .error {
            color: #c00;
            background-color: #fee;
            padding: 10px 20px;
            border-radius: 5px;
            margin: 10px 0;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(3px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            animation: fadeIn 0.2s ease-out;
        }

        .modal-card {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            max-width: 480px;
            width: 88%;
            text-align: center;
            animation: popIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .modal-icon {
            font-size: 42px;
            margin-bottom: 12px;
        }

        .modal-title {
            color: #b30000;
            margin: 0 0 12px 0;
            font-size: 20px;
            font-weight: 600;
        }

        .modal-message {
            color: #444;
            font-size: 15px;
            line-height: 1.5;
            margin: 0 0 24px 0;
            word-break: break-word;
        }

        .modal-close-btn {
            background-color: #1a5f2a;
            color: white;
            border: none;
            padding: 10px 26px;
            font-size: 15px;
            cursor: pointer;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

        .modal-close-btn:hover {
            background-color: #2a7f3a;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes popIn {
            from { transform: scale(0.9); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .footer {
            margin-top: 30px;
            color: #888;
            font-size: 12px;
        }

        .version-link {
            color: #666;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            transition: color 0.2s;
        }

        .version-link:hover {
            color: #1a5f2a;
        }

        .github-icon {
            display: inline-block;
            width: 14px;
            height: 14px;
        }
    </style>
</head>
<body>
    <div class="center">
        <div>
            <h1>🏕️ SkautIS Contacts Converter</h1>
            <h3>
                {% if github_url and hexsha_full %}
                    <a href="{{ github_url }}/commit/{{ hexsha_full }}" class="version-link" title="View commit on GitHub">
                        {% if version %}{{ version }}{% endif %}{% if version and hexsha_short %} / {% endif %}{% if hexsha_short %}{{ hexsha_short }}{% endif %}
                        <svg class="github-icon" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                        </svg>
                    </a>
                {% else %}
                    {% if version %}{{ version }}{% endif %}{% if version and hexsha_short %} / {% endif %}{% if hexsha_short %}{{ hexsha_short }}{% endif %}
                {% endif %}
            </h3>

            <p class="description">
                Nahrajte Excel soubor (.xlsx) exportovaný ze SkautISu a stáhněte si kontakty
                ve formátu CSV kompatibilním s Google Contacts.
            </p>

            {% if error %}
            <div class="error">{{ error }}</div>

            <div class="modal-overlay" id="errorModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
                <div class="modal-card">
                    <div class="modal-icon">⚠️</div>
                    <h2 id="modalTitle" class="modal-title">Chyba při zpracování</h2>
                    <p class="modal-message">{{ error }}</p>
                    <button type="button" class="modal-close-btn" onclick="closeModal()">Rozumím</button>
                </div>
            </div>
            {% endif %}

            <form method="POST" action="/" enctype="multipart/form-data" id="uploadForm">
                <input type="file" name="file" accept=".xlsx" id="fileInput" required>
                <br>
                <button type="submit">Převést a stáhnout</button>
            </form>
        </div>
    </div>
    <script>
        function closeModal() {
            var modal = document.getElementById('errorModal');
            if (modal) {
                modal.style.display = 'none';
            }
        }

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });

        // Close modal when clicking outside the card
        var modalOverlay = document.getElementById('errorModal');
        if (modalOverlay) {
            modalOverlay.addEventListener('click', function(e) {
                if (e.target === modalOverlay) {
                    closeModal();
                }
            });
        }

        // Clear file input after form submission (download starts)
        document.getElementById('uploadForm').addEventListener('submit', function() {
            setTimeout(function() {
                document.getElementById('fileInput').value = '';
            }, 100);
        });
    </script>
</body>
</html>
